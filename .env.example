# Server-only. Required for custom destinations (Claude place discovery + day clustering).
# Demo journeys — Kashmir, Kerala, Rajasthan — do not use this key.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-4-5.
ANTHROPIC_MODEL=claude-sonnet-4-5

# Public token for the Mapbox globe (flyTo, satellite style, markers).
# Without it, demo trips still render on a free map style.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Server token for Mapbox geocoding and directions on custom destinations.
# Falls back to NEXT_PUBLIC_MAPBOX_TOKEN when unset.
# Demo trips ship with coordinates and route geometries and do not need it.
MAPBOX_TOKEN=
